platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_setting_search_paths = %w(
    $(SRCROOT)
    $(SRCROOT)/..
    $(SRCROOT)/../..
  )
  out = IO.popen(['xcrun', 'xcodebuild', '-showBuildSettings',
                  '-project', "#{Dir.pwd}/Runner.xcodeproj",
                  '-target', 'Runner',
                  '-configuration', 'Release'], err: [:child, :out]) { |f| f.read }
  settings = out.split("\n").select { |l| l.include?("FLUTTER_ROOT") }
  raise "FLUTTER_ROOT not found in xcodebuild output. Run 'flutter pub get' first." if settings.empty?
  settings[0].split(" = ")[1].strip
end

flutter_root = flutter_root()

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
    end
  end
end
